    <string name="charts_expl_steps">Steps per day (or per week / month on long periods). Touch a bar to see its value.</string>
    <string name="charts_expl_kcal">Calories burned. Each bar is a day, a week or a month.</string>
    <string name="charts_expl_distance">Distance walked, run or ridden, in kilometers.</string>
    <string name="charts_expl_workouts">Number of workouts. Regularity matters more than one big session.</string>
    <string name="charts_expl_hr">Average heart rate of your workouts. A lower value for the same effort means you are getting fitter.</string>
