<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: Compose draws everything, so this only sets window basics -->
    <style name="Theme.HealthStats" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen (Android 12+ system splash, backported by core-splashscreen) -->
    <style name="Theme.HealthStats.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.HealthStats</item>
    </style>
</resources>
