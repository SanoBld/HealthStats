    <string name="sleep_rem">REM</string>
    <string name="sleep_light">Léger</string>
    <string name="sleep_awake">Éveillé</string>
    <string name="sleep_expl">Temps de sommeil chaque nuit. Le sommeil profond repose le corps, le REM aide la mémoire et l\'humeur, le léger sert de transition. Un adulte a besoin d\'environ 7 à 9 heures.</string>
    <string name="heart_title">Cœur</string>
    <string name="heart_avg_title">FC par jour</string>
    <string name="heart_expl">Votre FC au repos chaque jour. Une valeur qui baisse avec le temps signe en général une meilleure forme ; une hausse soudaine peut venir du stress, d\'une maladie ou d\'un mauvais sommeil.</string>
    <string name="heart_avg_expl">FC moyenne de chaque jour.</string>
