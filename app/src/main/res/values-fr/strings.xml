    <string name="charts_hr">Fréquence cardiaque</string>
    <string name="charts_expl_steps">Pas par jour (ou par semaine / mois sur les longues périodes). Touchez une barre pour voir sa valeur.</string>
    <string name="charts_expl_kcal">Calories brûlées. Chaque barre est un jour, une semaine ou un mois.</string>
    <string name="charts_expl_distance">Distance marchée, courue ou parcourue, en kilomètres.</string>
    <string name="charts_expl_workouts">Nombre de séances. La régularité compte plus qu\'une grosse séance.</string>
    <string name="charts_expl_hr">FC moyenne de vos séances. Une valeur plus basse pour le même effort = vous progressez.</string>
